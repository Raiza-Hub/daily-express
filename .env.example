# Frontend/runtime URLs
NEXT_PUBLIC_DAILYEXPRESS_API_URL=http://localhost:8000
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000
# Hostname (no protocol) of the R2 public bucket serving driver profile images
NEXT_PUBLIC_R2_HOSTNAME=profiles.yourdomain.com


# Product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/daily-express-flow
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
