{
  "name": "dailyexpress-email-worker",
  "display_name": "Daily Express Email Queue Consumer",
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/consumer.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "queues": {
    "consumers": [
      {
        "queue": "email-send",
        "max_batch_size": 2,
        "max_retries": 3,
        "dead_letter_queue": "email-send-dlq"
      }
    ]
  },
  "vars": {
    "SES_REGION": "eu-west-1",
    "AWS_SERVICE": "ses"
  }
}
